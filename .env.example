# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). The anon key is safe
# to ship in the built client -- it's the public key, access is enforced by
# Row Level Security and the SECURITY DEFINER functions in supabase/migrations.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
